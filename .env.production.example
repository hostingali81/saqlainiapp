# Production Environment Variables
# Copy this to .env.production and fill in your production values

NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_production_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_production_service_role_key
SYNC_SECRET_TOKEN=your_production_sync_token
AZURE_TTS_KEY=your_production_azure_key
AZURE_TTS_REGION=your_azure_region
GOOGLE_SHEET_ID=your_production_sheet_id
GOOGLE_SERVICE_ACCOUNT_JSON=your_production_service_account_json
